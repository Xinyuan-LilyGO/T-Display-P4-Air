menu "Example Configuration"

    choice
        prompt "Select the example to build"
        default EXAMPLE_BUILD_SCREEN_LVGL
            config EXAMPLE_BUILD_IIC_SCAN
                bool "iic_scan"
            config EXAMPLE_BUILD_SCREEN_LVGL
                bool "screen_lvgl"
            config EXAMPLE_BUILD_XL9535
                bool "xl9535"
            config EXAMPLE_BUILD_AXP517
                bool "axp517"
            config EXAMPLE_BUILD_AW86224
                bool "aw86224"
            config EXAMPLE_BUILD_ES8389
                bool "es8389"
            config EXAMPLE_BUILD_SCREEN_LVGL_TOUCH_DRAW
                bool "screen_lvgl_touch_draw"
            config EXAMPLE_BUILD_ESP_HOSTED_MCU_SDIO_WIFI
                bool "esp_hosted_mcu_sdio_wifi"
            config EXAMPLE_BUILD_IPERF
                bool "iperf"
            config EXAMPLE_BUILD_ESP_HOSTED_MCU_SDIO_WIFI_HTTP_DOWNLOAD_FILE
                bool "esp_hosted_mcu_sdio_wifi_http_download_file"
            config EXAMPLE_BUILD_SPIFFS
                bool "spiffs"
            config EXAMPLE_BUILD_ES8389_SPIFFS_MP3
                bool "es8389_spiffs_mp3"
            config EXAMPLE_BUILD_ESP_HOSTED_MCU_SDIO_WIFI_ES8389_MP3
                bool "esp_hosted_mcu_sdio_wifi_es8389_mp3"
            config EXAMPLE_BUILD_BHI260AP
                bool "bhi260ap"
            config EXAMPLE_BUILD_QMC6310N
                bool "qmc6310n"
            config EXAMPLE_BUILD_BHI260AP_QMC6310N
                bool "bhi260ap_qmc6310n"
            config EXAMPLE_BUILD_SGM38121
                bool "sgm38121"
            config EXAMPLE_BUILD_SCREEN_CAMERA
                bool "screen_camera"
            config EXAMPLE_BUILD_RADIOLIB_LR1121_SEND_RECEIVE
                bool "radiolib_lr1121_send_receive"
            config EXAMPLE_BUILD_ST25R3916
                bool "st25r3916"
            config EXAMPLE_BUILD_IR_NEC_TRANSCEIVER
                bool "ir_nec_transceiver"
            config EXAMPLE_BUILD_ES8389_SD_MP3
                bool "es8389_sd_mp3"
            config EXAMPLE_BUILD_NRF9151_UART
                bool "nrf9151_uart"
            config EXAMPLE_BUILD_RF_TEST
                bool "rf_test"
            config EXAMPLE_BUILD_SLEEP
                bool "sleep"
    endchoice

    choice
        prompt "Select the camera type"
        default CAMERA_TYPE_OV2710
            config CAMERA_TYPE_SC2336
                bool "SC2336"
            config CAMERA_TYPE_OV2710
                bool "OV2710"
            config CAMERA_TYPE_OV5645
                bool "OV5645"
    endchoice

    choice
        prompt "Select the color format of the screen"
        default SCREEN_PIXEL_FORMAT_RGB565
            config SCREEN_PIXEL_FORMAT_RGB565
                bool "RGB565"
            config SCREEN_PIXEL_FORMAT_RGB888
                bool "RGB888"
    endchoice

    choice
        prompt "Select the color format of the camera"
        default CAMERA_PIXEL_FORMAT_RGB565
            config CAMERA_PIXEL_FORMAT_RGB565
                bool "RGB565"
            config CAMERA_PIXEL_FORMAT_RGB888
                bool "RGB888"
    endchoice

endmenu
