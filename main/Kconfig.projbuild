menu "Example Configuration"

    choice
        prompt "Select the screen type"
        default SCREEN_TYPE_HI8561
            config SCREEN_TYPE_HI8561
                bool "HI8561"
    endchoice

    choice
        prompt "Select the example to build"
        default EXAMPLE_BUILD_IIC_SCAN
            config EXAMPLE_BUILD_IIC_SCAN
                bool "iic_scan"
    endchoice
endmenu
